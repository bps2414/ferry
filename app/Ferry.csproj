<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- só para o NotifyIcon (toast); sem os usings globais para não conflitar com os nomes do WPF -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Ferry</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- ThemeMode (Fluent) ainda é marcado como experimental -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <ApplicationIcon>Ferry.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <ProjectReference Include="..\core\Ferry.Core.csproj" />
    <EmbeddedResource Include="tools\7z.exe" LogicalName="7z.exe" />
    <EmbeddedResource Include="tools\7z.dll" LogicalName="7z.dll" />
    <!-- Geist (OFL, ver fonts/OFL.txt) e o ícone da janela, dentro do exe -->
    <Resource Include="fonts\*.ttf" />
    <Resource Include="Ferry.ico" />
    <EmbeddedResource Include="locales/*.json" WithCulture="false" LogicalName="Ferry.app.locales.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../web/ui/locales/*.json" WithCulture="false" LogicalName="Ferry.ui.locales.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
