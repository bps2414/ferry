<Application x:Class="Ferry.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- "PlayStation noir": preto-azulado, quase monocromático, um acento (azul). Verde/vermelho/âmbar só para estado. -->
        <Color x:Key="AccentColor">#6F97FF</Color>
        <Color x:Key="TextColor">#E9EDF3</Color>
        <Color x:Key="Text2Color">#A9B3C2</Color>
        <Color x:Key="GreenColor">#4ADE80</Color>
        <Color x:Key="RedColor">#FF7A7A</Color>
        <Color x:Key="AmberColor">#F2B84B</Color>
        <SolidColorBrush x:Key="Bg" Color="#0A0D12"/>
        <SolidColorBrush x:Key="Side" Color="#0D1117"/>
        <SolidColorBrush x:Key="Hover" Color="#0F141B"/>
        <SolidColorBrush x:Key="Line" Color="#1B222D"/>
        <SolidColorBrush x:Key="Line2" Color="#29323F"/>
        <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="Text2" Color="{StaticResource Text2Color}"/>
        <SolidColorBrush x:Key="Muted" Color="#8490A2"/>
        <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentText" Color="#9DB8FF"/>
        <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}"/>
        <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}"/>
        <SolidColorBrush x:Key="Amber" Color="{StaticResource AmberColor}"/>

        <!-- controles Fluent (slider, checkbox, foco da caixa de texto) no acento do Ferry, não no do Windows -->
        <Color x:Key="SystemAccentColor">#6F97FF</Color>
        <Color x:Key="SystemAccentColorLight1">#8AABFF</Color>
        <Color x:Key="SystemAccentColorLight2">#9DB8FF</Color>
        <Color x:Key="SystemAccentColorLight3">#BCD0FF</Color>
        <Color x:Key="SystemAccentColorDark1">#5A82E8</Color>
        <Color x:Key="SystemAccentColorDark2">#4A6FD0</Color>
        <Color x:Key="SystemAccentColorDark3">#3B5BB0</Color>
        <SolidColorBrush x:Key="AccentFillColorPrimaryBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SliderTrackFill" Color="#29323F"/>
        <SolidColorBrush x:Key="SliderThumbBackground" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#8AABFF"/>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#8AABFF"/>
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#5A82E8"/>
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#9DB8FF"/>

        <!-- Geist (OFL), embutida no exe -->
        <FontFamily x:Key="Sans">pack://application:,,,/Ferry;component/fonts/#Geist</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">pack://application:,,,/Ferry;component/fonts/#Geist</FontFamily>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <BooleanToVisibilityConverter x:Key="Vis"/>

        <!-- foco do teclado: contorno claro, visível no fundo escuro -->
        <Style x:Key="Focus">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" Stroke="{StaticResource Text}" StrokeThickness="1.5" RadiusX="5" RadiusY="5" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navegação: texto sobre fio; o ativo ganha o quadrado do acento -->
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,11">
                            <DockPanel>
                                <Rectangle x:Name="Mark" Width="6" Height="6" Fill="{StaticResource Accent}" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão com texto: contorno fino, canto 4 -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Background" Value="{StaticResource Side}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line2}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#161C25"/><Setter TargetName="Bd" Property="BorderBrush" Value="#3A4454"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#1D2430"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ação principal: bloco claro, texto escuro -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Bg}"/>
            <Setter Property="Background" Value="{StaticResource Text}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="#C9D0DA"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ação secundária em texto sublinhado -->
        <Style x:Key="LinkBtn" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="T" Text="{TemplateBinding Content}" TextDecorations="Underline" Background="Transparent"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="T" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão só com ícone (ações da linha); sempre com ToolTip e AutomationProperties.Name -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="FontFamily" Value="{StaticResource Icons}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource Text2}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Line}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Background" Value="{StaticResource Line2}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Progresso "travessia": cais nas pontas, fio no meio, a seta avança. Cor vem do Foreground. -->
        <Style x:Key="Bar" TargetType="ProgressBar">
            <Setter Property="Height" Value="12"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle Fill="{StaticResource Line2}"/>
                            <Rectangle Grid.Column="2" Fill="{StaticResource Line2}"/>
                            <Grid Grid.Column="1" Margin="6,0,12,0">
                                <Rectangle x:Name="PART_Track" Height="2" VerticalAlignment="Center" Fill="{StaticResource Line}"/>
                                <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                    <Rectangle Height="2" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
                                    <Path Data="M0,1 L4.5,5.5 L0,10" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
                                          HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-6,0"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <Style x:Key="Group" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,16"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
        </Style>
    </Application.Resources>
</Application>
