<UserControl x:Class="Ferry.BrandLogo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="Ferry" Focusable="False" IsTabStop="False"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="BrandGeometry.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Viewbox Grid.Column="0" Stretch="Uniform">
            <Canvas Width="256" Height="256">
                <Rectangle Canvas.Left="9" Canvas.Top="9" Width="238" Height="238" RadiusX="55" RadiusY="55" Fill="#121821" Stroke="#29323F" StrokeThickness="2"/>
                <Canvas Width="256" Height="256">
                    <Canvas.RenderTransform><ScaleTransform CenterX="128" CenterY="128" ScaleX="0.78" ScaleY="0.78"/></Canvas.RenderTransform>
                    <Path x:Name="Wave" Data="{StaticResource FerryWave}" Stroke="#6F97FF" StrokeThickness="20" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashCap="Round" StrokeLineJoin="Round" StrokeDashArray="{StaticResource FerryWaveDashes}"/>
                    <Canvas x:Name="HullGroup" Width="256" Height="256">
                        <Canvas.RenderTransform><TranslateTransform x:Name="HullOffset"/></Canvas.RenderTransform>
                        <Path Data="{StaticResource FerryHull}" Fill="#E9EDF3"/>
                    </Canvas>
                    <Canvas x:Name="CabinGroup" Width="256" Height="256">
                        <Canvas.RenderTransform><TranslateTransform x:Name="CabinOffset"/></Canvas.RenderTransform>
                        <Path Data="{StaticResource FerryCabin}" Fill="#E9EDF3"/>
                    </Canvas>
                </Canvas>
            </Canvas>
        </Viewbox>
        <Viewbox Grid.Column="2" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Canvas x:Name="Wordmark" Width="349" Height="148">
                <Canvas.RenderTransform><TranslateTransform x:Name="WordmarkOffset"/></Canvas.RenderTransform>
                <Canvas.Clip><RectangleGeometry Rect="0,0,349,148"><RectangleGeometry.Transform><ScaleTransform x:Name="WordmarkReveal"/></RectangleGeometry.Transform></RectangleGeometry></Canvas.Clip>
                <Path Data="{StaticResource FerryWordmark}" Fill="#E9EDF3"/>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>
