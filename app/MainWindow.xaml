<Window x:Class="Ferry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Ferry;assembly=Ferry.Core"
        xmlns:text="clr-namespace:Ferry"
        Title="{text:Loc app.title}" Width="1120" Height="740" MinWidth="1000" MinHeight="560" Icon="Ferry.ico"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="{StaticResource Sans}" FontSize="14" Typography.NumeralAlignment="Tabular"
        AllowDrop="True" DragEnter="OnDragEnter" DragOver="OnDragOver" DragLeave="OnDragLeave" Drop="OnDrop"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ BARRA LATERAL ============ -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,22,20,20">
                <!-- marca: símbolo "Travessia" + Ferry -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Viewbox Width="32" Height="32" VerticalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path Data="{StaticResource LogoPosts}" Fill="{StaticResource Text}"/>
                            <Path Data="{StaticResource LogoArrow}" Fill="{StaticResource Accent}"/>
                        </Canvas>
                    </Viewbox>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{text:Loc app.title}" FontSize="22" FontWeight="SemiBold" LineHeight="22" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock Text="{text:Loc ui.tagline}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- status do PS5: texto, sem cartão -->
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusTitle" Text="{text:Loc ui.untested}" FontWeight="SemiBold" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="StatusHost" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="StatusDest" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    <!-- PS5 achado na rede: só oferece, nunca troca sozinho -->
                    <Border x:Name="FoundBar" Visibility="Collapsed" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock x:Name="FoundText" FontSize="12.5" Foreground="{StaticResource Text}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="{text:Loc ui.useFound}" Style="{StaticResource Primary}" Height="30" Padding="12,0" Click="OnUseFound"/>
                                <Button Content="{text:Loc ui.ignore}" Style="{StaticResource LinkBtn}" Margin="14,0,0,0" VerticalAlignment="Center" Click="OnDismissFound"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button x:Name="SideTestBtn" Content="{text:Loc ui.test}" Style="{StaticResource LinkBtn}" Margin="0,12,0,0" Click="OnTest"/>
                </StackPanel>

                <StackPanel Margin="0,40,0,0">
                    <RadioButton x:Name="NavQueue" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True" Checked="OnNav">
                        <DockPanel>
                            <Border x:Name="QueueBadge" DockPanel.Dock="Right" Visibility="Collapsed">
                                <TextBlock x:Name="QueueBadgeText" Foreground="{StaticResource Text2}" FontWeight="Normal"/>
                            </Border>
                            <TextBlock Text="{text:Loc ui.queue}"/>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNav" Content="{text:Loc ui.settings}"/>
                    <RadioButton x:Name="NavLog" Style="{StaticResource NavItem}" GroupName="nav" Checked="OnNav" Content="{text:Loc ui.log}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ CONTEÚDO ============ -->
        <Grid Grid.Column="1" Margin="32,26,32,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,18">
                <StackPanel>
                    <CheckBox x:Name="ShutdownAfterBox" Content="{text:Loc app.shutdownAfter}" Checked="OnShutdownAfterChanged" Unchecked="OnShutdownAfterChanged"
                              AutomationProperties.Name="{text:Loc app.shutdownAfter}"/>
                    <TextBlock Text="{text:Loc app.powerHint}" Style="{StaticResource Hint}"/>
                    <DockPanel Margin="0,6,0,0">
                        <Button x:Name="CancelShutdownBtn" DockPanel.Dock="Right" Content="{text:Loc app.cancelShutdown}" Style="{StaticResource Btn}"
                                Click="OnCancelShutdown" Visibility="Collapsed" Margin="12,0,0,0" AutomationProperties.Name="{text:Loc app.cancelShutdown}"/>
                        <TextBlock x:Name="PowerStatusText" Text="{text:Loc app.powerOff}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </DockPanel>
                    <CheckBox x:Name="KeepAwakeBox" Content="{text:Loc app.keepAwake}" Margin="0,8,0,0"
                              Checked="OnKeepAwakeChanged" Unchecked="OnKeepAwakeChanged" AutomationProperties.Name="{text:Loc app.keepAwake}"/>
                </StackPanel>
            </Border>

            <!-- == FILA == -->
            <Grid x:Name="QueuePage" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <!-- velocidade total agora -->
                            <StackPanel x:Name="SpeedPill" Margin="0,0,24,0" Visibility="Collapsed" VerticalAlignment="Bottom">
                                <TextBlock HorizontalAlignment="Right" FontSize="30" FontWeight="SemiBold" LineHeight="30" LineStackingStrategy="BlockLineHeight">
                                    <Run x:Name="SpeedText"/><Run x:Name="SpeedUnit" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Muted}"/>
                                </TextBlock>
                                <TextBlock Text="{text:Loc ui.totalNow}" FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="ClearBtn" Content="{text:Loc ui.clearDone}" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="OnClearFinished" Visibility="Collapsed"/>
                            <Button Style="{StaticResource Primary}" Click="OnPickFiles">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="{text:Loc ui.addFiles}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="{text:Loc ui.queue}" FontSize="34" FontWeight="SemiBold" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
                            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,8,0,0" Text="{text:Loc ui.emptyQueue}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- vazio: a travessia parada no cais; clique abre o seletor do Windows -->
                <Grid Grid.Row="1" x:Name="EmptyHint" Cursor="Hand" MouseLeftButtonUp="OnPickFiles" Background="Transparent">
                    <StackPanel VerticalAlignment="Center" MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,40">
                        <TextBlock Text="{text:Loc ui.emptyTitle}" FontSize="58" FontWeight="SemiBold"/>
                        <TextBlock Foreground="{StaticResource Text2}" FontSize="16" TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="24"
                                   Text="{text:Loc app.emptyHint}"/>
                        <ProgressBar Style="{StaticResource Bar}" Value="0" Foreground="{StaticResource Accent}" Margin="0,40,0,0"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock x:Name="EmptyDest" DockPanel.Dock="Right" FontSize="12.5" Foreground="{StaticResource Text2}"/>
                            <TextBlock Text="{text:Loc app.thisPc}" FontSize="12.5" Foreground="{StaticResource Text2}"/>
                        </DockPanel>
                        <TextBlock Text="{text:Loc app.extensions}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,32,0,0"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl x:Name="JobList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:Job}">
                                <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="0,18,4,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="88"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="96"/>
                                            <ColumnDefinition Width="104"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- capa (sem capa, o nome do arquivo ocupa o lugar dela em tipografia grande) -->
                                        <Image x:Name="Cover" Width="88" Height="88" Stretch="UniformToFill" VerticalAlignment="Top" Source="{Binding Icon}">
                                            <Image.Clip><RectangleGeometry Rect="0,0,88,88" RadiusX="3" RadiusY="3"/></Image.Clip>
                                        </Image>

                                        <StackPanel x:Name="Info" Grid.Column="1" Margin="20,0,16,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Title}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Title}" Value=""><Setter Property="Text" Value="{Binding Name}"/></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <WrapPanel Margin="0,5,0,0">
                                                <TextBlock x:Name="StageLbl" Text="{text:JobText Stage}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Text2}" Margin="0,0,14,0"/>
                                                <TextBlock x:Name="IdLbl" Text="{Binding TitleId}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                                <TextBlock Text="{Binding Package.Format}" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,14,0"/>
                                                <TextBlock x:Name="AmountLbl" Text="{text:JobText Amount}" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                                            </WrapPanel>
                                            <TextBlock x:Name="DetailText" Text="{text:JobText Detail}" ToolTip="{text:JobText Detail}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="FileLbl" Text="{Binding CurrentFile}" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- números grandes, em colunas fixas para alinhar de linha a linha -->
                                        <StackPanel x:Name="PctCell" Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock HorizontalAlignment="Right" FontSize="28" FontWeight="SemiBold"><Run Text="{text:JobText Progress}"/><Run Text="%" FontSize="13" FontWeight="Medium" Foreground="{StaticResource Muted}"/></TextBlock>
                                            <TextBlock Text="{text:Loc ui.sent}" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="RateCell" Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="{text:JobText RateValue}" HorizontalAlignment="Right" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="{text:JobText RateUnit}" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel x:Name="EtaCell" Grid.Column="4" VerticalAlignment="Center">
                                            <TextBlock Text="{text:JobText EtaValue}" HorizontalAlignment="Right" FontSize="28" FontWeight="SemiBold"/>
                                            <TextBlock Text="{text:JobText EtaUnit}" FontSize="11.5" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <!-- na fila/pausado: passa na frente do envio atual (que volta para a fila e continua depois) -->
                                        <Button x:Name="SendNowBtn" Grid.Column="3" Grid.ColumnSpan="2" Style="{StaticResource Btn}" Content="{text:Loc ui.sendNow}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnSendNow"
                                                ToolTip="{text:Loc ui.sendNowHint}"
                                                Visibility="{Binding CanSendNow, Converter={StaticResource Vis}}"/>
                                        <Button x:Name="InstallBtn" Grid.Column="2" Grid.ColumnSpan="3" Style="{StaticResource Btn}" Content="{text:Loc ui.requestInstall}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" Click="OnRequestInstall"
                                                ToolTip="{text:Loc ui.requestInstallHint}" Visibility="{Binding CanRequestInstall, Converter={StaticResource Vis}}"/>

                                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Button Style="{StaticResource IconButton}" Content="&#xE769;" ToolTip="{text:Loc ui.pause}" AutomationProperties.Name="{text:Loc ui.pause}" Click="OnPause" Visibility="{Binding CanPause, Converter={StaticResource Vis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="{text:Loc ui.resume}" AutomationProperties.Name="{text:Loc ui.resume}" Click="OnResume" Visibility="{Binding CanResume, Converter={StaticResource Vis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="{text:Loc ui.retryHint}" AutomationProperties.Name="{text:Loc ui.retry}" Click="OnRetry" Foreground="{StaticResource Text}" Visibility="{Binding CanRetry, Converter={StaticResource Vis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="{text:Loc ui.cancel}" AutomationProperties.Name="{text:Loc ui.cancel}" Click="OnCancel" Visibility="{Binding CanCancel, Converter={StaticResource Vis}}"/>
                                            <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{text:Loc ui.remove}" AutomationProperties.Name="{text:Loc ui.remove}" Click="OnRemove"/>
                                        </StackPanel>

                                        <!-- a travessia: anima suave até o valor novo (OnProgress) -->
                                        <ProgressBar x:Name="Bar" Grid.Row="1" Grid.ColumnSpan="6" Style="{StaticResource Bar}" Margin="0,16,0,0"
                                                     Tag="{Binding Progress, NotifyOnTargetUpdated=True}" Binding.TargetUpdated="OnProgress">
                                            <ProgressBar.Foreground><SolidColorBrush Color="#4A5363"/></ProgressBar.Foreground>
                                        </ProgressBar>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                        <Setter TargetName="Cover" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Info" Property="Grid.Column" Value="0"/>
                                        <Setter TargetName="Info" Property="Grid.ColumnSpan" Value="2"/>
                                        <Setter TargetName="Info" Property="Margin" Value="0,0,16,0"/>
                                        <Setter TargetName="TitleText" Property="FontSize" Value="30"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding TitleId}" Value=""><Setter TargetName="IdLbl" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding Amount}" Value=""><Setter TargetName="AmountLbl" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{text:JobText Detail}" Value=""><Setter TargetName="DetailText" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentFile}" Value=""><Setter TargetName="FileLbl" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter TargetName="PctCell" Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
                                        <Setter TargetName="RateCell" Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
                                        <Setter TargetName="EtaCell" Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanSendNow}" Value="True">
                                        <Setter TargetName="RateCell" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="EtaCell" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>

                                    <!-- estado: cor do rótulo e transição de cor da travessia -->
                                    <DataTrigger Binding="{Binding Stage}" Value="AguardandoPartes">
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="#4A5363" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="NaFila">
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="#4A5363" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Cancelado">
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="#4A5363" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Extraindo">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource AccentText}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AccentColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Enviando">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource AccentText}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AccentColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Verificado">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Green}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource GreenColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CanRequestInstall}" Value="True">
                                        <Setter TargetName="PctCell" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="RateCell" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="EtaCell" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="PacotePronto">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Amber}"/>
                                        <Setter TargetName="DetailText" Property="TextWrapping" Value="Wrap"/>
                                        <Setter TargetName="DetailText" Property="TextTrimming" Value="None"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AmberColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="SolicitandoInstalacao">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource AccentText}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AccentColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="InstalacaoSolicitada">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Green}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource GreenColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="VerifiqueNoPs5">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Amber}"/>
                                        <Setter TargetName="InstallBtn" Property="Content" Value="{text:Loc ui.resendInstall}"/>
                                        <Setter TargetName="DetailText" Property="TextWrapping" Value="Wrap"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AmberColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Pausado">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Amber}"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource AmberColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Stage}" Value="Erro">
                                        <Setter TargetName="StageLbl" Property="Foreground" Value="{StaticResource Red}"/>
                                        <Setter TargetName="DetailText" Property="Foreground" Value="{StaticResource Red}"/>
                                        <Setter TargetName="DetailText" Property="TextWrapping" Value="Wrap"/>
                                        <DataTrigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="(ProgressBar.Foreground).(SolidColorBrush.Color)" To="{StaticResource RedColor}" Duration="0:0:0.3"/></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- aparece ao arrastar arquivos por cima -->
                <Border x:Name="DropOverlay" Grid.RowSpan="2" Background="#F20A0D12" BorderBrush="{StaticResource Accent}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                    <StackPanel VerticalAlignment="Center" Margin="48,0">
                        <TextBlock Text="{text:Loc app.drop}" FontSize="40" FontWeight="SemiBold"/>
                        <ProgressBar Style="{StaticResource Bar}" Value="100" Foreground="{StaticResource Accent}" Margin="0,28,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- == CONFIGURAÇÕES: duas colunas, sem rolar no tamanho padrão (rola só se a janela ficar menor) == -->
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Focusable="False">
                <Grid x:Name="SettingsPanel" MinHeight="800" Binding.SourceUpdated="OnSourceUpdated">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="0,0,0,18">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{text:Loc ui.autosaved}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{text:Loc ui.settings}" FontSize="34" FontWeight="SemiBold" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- esquerda: conexão e destino -->
                        <StackPanel>

                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc app.ps5}" Style="{StaticResource GroupTitle}"/>
                                    <TextBlock Text="{text:Loc ui.host}" Style="{StaticResource Label}"/>
                                    <DockPanel>
                                        <Button x:Name="FindBtn" DockPanel.Dock="Right" Content="{text:Loc ui.discover}" Style="{StaticResource Btn}" Margin="10,0,0,0" ToolTip="{text:Loc app.discoverHint}" Click="OnFind"/>
                                        <TextBox x:Name="HostBox" TextChanged="OnHostChanged" AutomationProperties.Name="{text:Loc app.hostAria}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="HostHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{text:Loc ui.port}" Style="{StaticResource Label}"/>
                                            <TextBox x:Name="PortBox" TextChanged="OnPortChanged" AutomationProperties.Name="{text:Loc ui.port}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="{text:Loc ui.user}" Style="{StaticResource Label}"/>
                                            <TextBox Text="{Binding User, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="{text:Loc ui.user}"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="PortHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Text="{text:Loc ui.ftpHint}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{text:Loc ui.ftpPassword}" Style="{StaticResource Label}" Margin="0,12,0,5"/>
                                    <PasswordBox x:Name="PwBox" PasswordChanged="OnPwChanged" AutomationProperties.Name="{text:Loc ui.ftpPassword}"/>
                                    <DockPanel Margin="0,14,0,0">
                                        <Button x:Name="TestBtn" Content="{text:Loc ui.test}" Style="{StaticResource Btn}" Click="OnTest"/>
                                        <TextBlock x:Name="TestResult" VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Group}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc ui.destination}" Style="{StaticResource GroupTitle}"/>
                                    <TextBlock Text="{text:Loc ui.gamesFolder}" Style="{StaticResource Label}"
                                               ToolTip="{text:Loc app.gamesFolderHint}"/>
                                    <DockPanel>
                                        <ComboBox x:Name="Preset" DockPanel.Dock="Left" Width="150" Margin="0,0,10,0" SelectionChanged="OnPreset" AutomationProperties.Name="{text:Loc app.storage}">
                                            <ComboBoxItem Content="{text:Loc app.m2}" Tag="/mnt/ext1/homebrew"/>
                                            <ComboBoxItem Content="{text:Loc ui.internalSsd}" Tag="/data/homebrew"/>
                                        </ComboBox>
                                        <TextBox Text="{Binding RemoteDir, UpdateSourceTrigger=PropertyChanged, NotifyOnSourceUpdated=True}" AutomationProperties.Name="{text:Loc ui.gamesFolderAria}"/>
                                    </DockPanel>
                                    <TextBlock Text="{text:Loc ui.exfat}" Style="{StaticResource Label}" Margin="0,12,0,5"
                                               ToolTip="{text:Loc app.exfatHint}"/>
                                    <TextBox x:Name="ImageBox" TextChanged="OnImageDirChanged" AutomationProperties.Name="{text:Loc app.exfatFolder}"/>
                                    <TextBlock x:Name="ImageHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Text="{text:Loc ui.pkgDir}" Style="{StaticResource Label}" Margin="0,12,0,5"/>
                                    <TextBox x:Name="PkgBox" TextChanged="OnPkgDirChanged" AutomationProperties.Name="{text:Loc ui.pkgDir}"/>
                                    <TextBlock x:Name="PkgHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Text="{text:Loc ui.pkgHint}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{text:Loc ui.pkgSpaceHint}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{text:Loc ui.pkgCompatibilityHint}" Style="{StaticResource Hint}"/>
                                    <CheckBox x:Name="AutoInstallPackagesBox" Margin="0,12,0,0" AutomationProperties.Name="{text:Loc ui.autoInstallPackages}"
                                              IsChecked="{Binding AutoInstallPackages, NotifyOnSourceUpdated=True}">
                                        <TextBlock Text="{text:Loc ui.autoInstallPackages}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                    <TextBlock Text="{text:Loc ui.autoInstallPackagesHint}" Style="{StaticResource Hint}"/>
                                    <TextBlock Text="{text:Loc ui.dpiPort}" Style="{StaticResource Label}" Margin="0,12,0,5"/>
                                    <TextBox x:Name="DpiPortBox" TextChanged="OnDpiPortChanged" AutomationProperties.Name="{text:Loc ui.dpiPort}"/>
                                    <TextBlock x:Name="DpiPortHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Text="{text:Loc ui.dpiHint}" Style="{StaticResource Hint}"/>
                                    <Expander x:Name="DpiHelp" Header="{text:Loc ui.dpiHelpTitle}" Margin="0,10,0,0" AutomationProperties.Name="{text:Loc ui.dpiHelpTitle}">
                                        <StackPanel Margin="0,6,0,0">
                                            <TextBlock Text="{text:Loc ui.dpiHelpStep1}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{text:Loc ui.dpiHelpStep2}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{text:Loc ui.dpiHelpStep3}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{text:Loc ui.dpiHelpConfig}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{text:Loc ui.dpiHelpV2}" Style="{StaticResource Hint}"/>
                                            <TextBlock Text="{text:Loc ui.dpiHelpCompatibility}" Style="{StaticResource Hint}"/>
                                        </StackPanel>
                                    </Expander>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button x:Name="DpiTestBtn" Content="{text:Loc ui.dpiTest}" Style="{StaticResource Btn}" Click="OnDpiTest" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="DpiTestResult" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Group}" BorderThickness="0">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc ui.webhook}" Style="{StaticResource GroupTitle}"/>
                                    <CheckBox x:Name="WebhookEnabledBox" Content="{text:Loc ui.webhookEnabled}" Checked="OnWebhookEnabledChanged" Unchecked="OnWebhookEnabledChanged"/>
                                    <DockPanel Margin="0,10,0,0">
                                        <ComboBox x:Name="WebhookKindBox" Width="145" DockPanel.Dock="Left" Margin="0,0,10,0" SelectionChanged="OnWebhookKindChanged" AutomationProperties.Name="{text:Loc app.webhookService}">
                                            <ComboBoxItem Content="{text:Loc ui.webhookGeneric}" Tag="generic"/>
                                            <ComboBoxItem Content="{text:Loc app.discord}" Tag="discord"/>
                                            <ComboBoxItem Content="{text:Loc app.ntfy}" Tag="ntfy"/>
                                        </ComboBox>
                                        <PasswordBox x:Name="WebhookUrlBox" PasswordChanged="OnWebhookUrlChanged" AutomationProperties.Name="{text:Loc ui.webhookUrl}" ToolTip="{text:Loc app.webhookUrlHint}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="WebhookHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{text:Loc app.webhookHint}"/>
                                    <DockPanel Margin="0,10,0,0">
                                        <Button x:Name="WebhookTestBtn" DockPanel.Dock="Left" Content="{text:Loc ui.webhookTest}" Style="{StaticResource Btn}" Click="OnWebhookTest" Margin="0,0,10,0"/>
                                        <TextBlock x:Name="WebhookTestResult" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- direita: pasta monitorada, envio e senhas (a caixa de senhas estica até o fim) -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Style="{StaticResource Group}">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc ui.language}" Style="{StaticResource GroupTitle}"/>
                                    <ComboBox x:Name="LanguageBox" SelectionChanged="OnLanguageChanged" AutomationProperties.Name="{text:Loc ui.language}">
                                        <ComboBoxItem Content="{text:Loc ui.languageAuto}" Tag="auto"/>
                                        <ComboBoxItem Content="{text:Loc app.languagePt}" Tag="pt-BR"/>
                                        <ComboBoxItem Content="{text:Loc app.languageEn}" Tag="en"/>
                                    </ComboBox>
                                    <TextBlock Text="{text:Loc app.languageHint}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Group}">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc ui.watchFolder}" Style="{StaticResource GroupTitle}"/>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="{text:Loc app.choose}" Style="{StaticResource Btn}" Margin="10,0,0,0" Click="OnPickFolder"/>
                                        <TextBox x:Name="FolderBox" TextChanged="OnFolderChanged" AutomationProperties.Name="{text:Loc ui.watchFolder}"/>
                                    </DockPanel>
                                    <TextBlock x:Name="FolderHint" Style="{StaticResource Hint}" Foreground="{StaticResource Red}" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource Hint}" Text="{text:Loc app.watchHint}"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Group}">
                                <StackPanel>
                                    <TextBlock Text="{text:Loc ui.transfer}" Style="{StaticResource GroupTitle}"/>
                                    <TextBlock Text="{text:Loc ui.connections}" Style="{StaticResource Label}"
                                               ToolTip="{text:Loc app.connectionsHint}"/>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Connections}" Width="28" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="15"/>
                                        <Slider Minimum="1" Maximum="8" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding Connections, NotifyOnSourceUpdated=True}" VerticalAlignment="Center" AutomationProperties.Name="{text:Loc ui.connections}"/>
                                    </DockPanel>
                                    <CheckBox Margin="0,12,0,0" Content="{text:Loc ui.deleteOriginal}" IsChecked="{Binding DeleteOriginal, NotifyOnSourceUpdated=True}"/>
                                    <TextBlock Text="{text:Loc ui.pkgRetentionHint}" Style="{StaticResource Hint}"/>
                                </StackPanel>
                            </Border>
                            <DockPanel Grid.Row="3" Margin="0,16,0,0">
                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource GroupTitle}">
                                    <Run Text="{text:Loc ui.knownPasswords}"/><Run Text="{text:Loc app.passwordsHint}" FontWeight="Normal" FontSize="12" Foreground="{StaticResource Muted}"/>
                                </TextBlock>
                                <TextBox x:Name="PwList" AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnPwListChanged"
                                         AutomationProperties.Name="{text:Loc ui.knownPasswords}"
                                         ToolTip="{text:Loc app.passwordsTooltip}"/>
                            </DockPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- == LOG == -->
            <DockPanel x:Name="LogPage" Grid.Row="1" Visibility="Collapsed">
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line2}" BorderThickness="0,0,0,1" Padding="0,0,0,18" Margin="0,0,0,18">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="{text:Loc ui.copy}" Style="{StaticResource Btn}" Click="OnCopyLog" Margin="0,0,8,0"/>
                            <Button Content="{text:Loc ui.clear}" Style="{StaticResource Btn}" Click="OnClearLog"/>
                        </StackPanel>
                        <TextBlock Text="{text:Loc ui.log}" FontSize="34" FontWeight="SemiBold" LineHeight="34" LineStackingStrategy="BlockLineHeight"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         Foreground="{StaticResource Text2}" Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" Padding="14"
                         AutomationProperties.Name="{text:Loc ui.log}"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
