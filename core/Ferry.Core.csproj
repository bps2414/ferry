<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica do Ferry sem interface: usada pelo app Windows (WPF), pelo servidor web e pelo E2E -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Ferry</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentFTP" Version="53.*" />
    <!-- DPAPI no Windows (senha do jogo na fila) -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.*" />
  </ItemGroup>

</Project>
